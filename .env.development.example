# Template for tunneled development environment
# Copy to .env.development and fill in values from your AWS development account
#
# Usage: make local-start env=dev

# AWS Credentials (use IAM role or access keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# API Configuration
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug

# Application URLs
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
