# ⚠️  WARNING: This template is for tunneling to PRODUCTION AWS services.
# Only use this for debugging production issues. All reads/writes go to real data.
#
# Usage: make local-start env=prod
#
# Copy to .env.production and fill in values from your AWS production account.

# AWS Credentials (use IAM role or access keys with least-privilege)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# API Configuration
NODE_ENV=production
API_PORT=3001
LOG_LEVEL=warn

# Application URLs
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
